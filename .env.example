# Application API Configuration
API_PORT=8080
DLM_DATA_DIR=data
DLM_LOG_DIR=logs
DLM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security (set before starting in production/docker; never commit real secrets)
DLM_AUTH_SECRET=change-me-to-a-random-64-char-hex-secret
# Optional first-run bootstrap credentials (otherwise use UI first-run setup):
# DLM_ADMIN_USER=admin
# DLM_ADMIN_PASSWORD=your-strong-password-here

# Node cluster ports
NODE1_PORT=9001
NODE2_PORT=9002
NODE3_PORT=9003
FRONTEND_PORT=3000
